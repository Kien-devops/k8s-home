# SonarQube connection settings (used by CI and local scripts)
# Generate token: SonarQube UI > Administration > Security > Users > Tokens

SONAR_HOST_URL=https://sonar.teamdevops.shop
SONAR_TOKEN=<generated-token-from-sonarqube-ui>
SONAR_PROJECT_KEY_BACKEND=k8s-home
SONAR_PROJECT_KEY_FRONTEND=hospital-frontend
