# =============================================================================
# Security Stack Environment — Monitor Server (100.112.150.56)
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to git. Only .env.example is tracked.
# =============================================================================

# --- Bind Address ---
# 127.0.0.1 = localhost only (safer default)
# 0.0.0.0   = all interfaces (use only behind firewall/Tailscale)
BIND_ADDRESS=0.0.0.0

# --- SonarQube ---
SONARQUBE_PORT=9000

# --- SonarQube PostgreSQL Database ---
SONAR_POSTGRES_USER=sonar
SONAR_POSTGRES_PASSWORD=SonarDB-K8sHome-2026!
SONAR_POSTGRES_DB=sonarqube

# --- Nexus ---
NEXUS_PORT=8081
